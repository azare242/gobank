# Copy to .env and replace this value with: openssl rand -base64 32
JWT_SECRET=replace-with-generated-base64-secret
JWT_ISSUER=gobank
JWT_AUDIENCE=gobank-api

LISTEN_ADDR=0.0.0.0:3000

# SQLite (enabled by default). Leave DB_DSN empty to use DB_PATH.
DB_DRIVER=sqlite
DB_PATH=users.db
DB_DSN=
# Alternatively, set DB_DSN to a SQLite filename or URI; it overrides DB_PATH.
# DB_DSN='file:bank.db?mode=rwc'

# PostgreSQL: comment out the SQLite DB_DRIVER and DB_DSN above,
# then uncomment these two lines. Create the database before starting the server.
# DB_PATH is unused with PostgreSQL. This example is for local development.
# DB_DRIVER=postgres
# DB_DSN='host=localhost port=5432 user=gobank password=development-password dbname=gobank sslmode=disable'

MAX_CONCURRENT_REQUESTS=100
